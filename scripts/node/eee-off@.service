# Disable Energy Efficient Ethernet (802.3az) on %i.
#
# Leading suspect for the intermittent blackholes: the interface keeps reporting
# 1Gbps/Full with `Link detected: yes` and zero error counters, while no ARP
# resolves to anything on the LAN and the kernel logs nothing at all. Recovery
# needs a reboot. Every node has now done it.
#
# EEE is enabled on these NICs and the switch reports no EEE support back
# ("Link partner advertised EEE link modes: Not reported"). A PHY that enters
# Low Power Idle and fails to wake the datapath cleanly produces exactly this
# signature. That is a HYPOTHESIS, not a diagnosis -- but the test is nearly
# free and the failure mode is expensive.
#
# Templated on the interface and bound to the DEVICE rather than to boot, so it
# re-applies whenever the interface reappears -- including after a link bounce,
# which is the other recovery being tried.
[Unit]
Description=Disable Energy Efficient Ethernet on %i
BindsTo=sys-subsystem-net-devices-%i.device
After=sys-subsystem-net-devices-%i.device

[Service]
Type=oneshot
RemainAfterExit=yes
# `|| true`: a NIC whose driver does not implement EEE returns non-zero, and
# that must not leave the unit failed on a node where there is nothing to do.
ExecStart=/bin/sh -c '/usr/sbin/ethtool --set-eee %i eee off || true'

[Install]
WantedBy=sys-subsystem-net-devices-%i.device
