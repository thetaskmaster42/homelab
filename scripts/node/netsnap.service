# One network snapshot. Driven by netsnap.timer; not enabled directly.
[Unit]
Description=Capture a network state snapshot
# Do not queue snapshots behind a hung one. During a blackhole some of these
# commands block, and a minute-by-minute timer would otherwise pile up.
[Service]
Type=oneshot
ExecStart=/usr/local/bin/netsnap-rotate.sh
TimeoutStartSec=50
Nice=10
IOSchedulingClass=idle
