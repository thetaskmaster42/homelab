# Every minute, on the minute.
#
# 58KB per snapshot is roughly 82MB/day of writes. These nodes boot from SD, so
# that is worth knowing, but it is far below what the cards are rated for and
# only two files are ever kept.
[Unit]
Description=Network state snapshot every minute

[Timer]
OnCalendar=*:*:00
# Catch up once after a reboot rather than waiting for the next minute boundary
# -- the snapshot immediately after a recovery is a useful baseline.
Persistent=true
AccuracySec=1s

[Install]
WantedBy=timers.target
